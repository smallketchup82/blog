---
interface Props {
  repo: string;
  title: string;
  description: string;
  language: string;
  status?: string;
  contributions?: boolean;
}

const { repo, title, description, language, status, contributions } = Astro.props;
const url = `https://github.com/${repo}${contributions ? '/pulls?q=is%3Apr+author%3Asmallketchup82' : ''}`;
---

<aside class="onebox" aria-label={`${title} project`}>
  <div class="source">
    <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true">
      <path d="M12 .75a11.25 11.25 0 0 0-3.56 21.92c.56.1.77-.24.77-.54v-2.1c-3.13.68-3.79-1.33-3.79-1.33-.51-1.3-1.25-1.65-1.25-1.65-1.02-.7.08-.69.08-.69 1.13.08 1.73 1.16 1.73 1.16 1 1.72 2.64 1.22 3.28.93.1-.73.39-1.22.71-1.5-2.5-.29-5.13-1.25-5.13-5.56 0-1.23.44-2.23 1.16-3.02-.12-.28-.5-1.43.11-2.98 0 0 .95-.3 3.1 1.15a10.8 10.8 0 0 1 5.64 0c2.15-1.45 3.1-1.15 3.1-1.15.61 1.55.23 2.7.11 2.98.72.79 1.16 1.79 1.16 3.02 0 4.32-2.64 5.27-5.15 5.55.4.35.76 1.03.76 2.08v3.11c0 .3.2.65.78.54A11.25 11.25 0 0 0 12 .75Z" />
    </svg>
    <a href={`https://github.com/${repo}`}>github.com/{repo}</a>
  </div>
  <h2><a href={url}>{title}</a></h2>
  <p>{description}</p>
  <div class="metadata">
    <span>{language}</span>
    {status && <span>{status}</span>}
  </div>
</aside>

<style>
  .onebox {
    border: 1px solid #606060;
    border-left: 3px solid #737373;
    background: #303030;
    padding: 1rem;
    min-width: 0;
    font-size: 1rem;
    line-height: 1.5;
  }
  .source {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    color: #b5b5b5;
    font-size: 0.8rem;
    margin-bottom: 0.65rem;
  }
  .source svg { flex-shrink: 0; margin-top: 0.12rem; }
  .onebox .source a { color: inherit; text-decoration: none; overflow-wrap: anywhere; }
  h2 { margin: 0 0 0.4rem; font-size: 1.2rem; font-weight: 600; line-height: 1.35; }
  .onebox h2 a { color: #69b9ec; text-decoration: none; overflow-wrap: anywhere; }
  .onebox a:hover { text-decoration: underline; }
  .onebox a:focus-visible { outline: 2px solid #69b9ec; outline-offset: 4px; }
  p { margin: 0; color: #e0e0e0; }
  .metadata { display: flex; flex-wrap: wrap; gap: 0.4rem 1rem; margin-top: 0.85rem; color: #b5b5b5; font-size: 0.8rem; }
</style>
